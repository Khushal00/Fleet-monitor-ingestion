# Copy to .env for local development. Values below are non-secret demo placeholders.
HTTP_PORT=8001

# TimescaleDB with PostGIS enabled
DB_HOST=localhost
DB_PORT=5432
DB_USER=fleet_user
DB_PASSWORD=replace_with_local_demo_password
DB_NAME=fleet_monitor
DB_MAX_CONNS=15

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication: leave empty to use Redis-seeded demo device keys.
VALID_API_KEYS=
AUTH_CACHE_TTL_SECONDS=300

# Pipeline buffers and workers
DB_CHANNEL_SIZE=10000
STATE_CHANNEL_SIZE=50000
ALERT_CHANNEL_SIZE=10000
DB_BATCH_SIZE=500
DB_FLUSH_INTERVAL_MS=100
DB_WRITER_WORKERS=10
STATE_WRITER_WORKERS=5
ALERT_WORKERS=3

# Copy to .env for local development. Values below are non-secret demo placeholders.
HTTP_PORT=8002

# TimescaleDB with PostGIS enabled
DB_HOST=localhost
DB_PORT=5432
DB_USER=fleet_user
DB_PASSWORD=replace_with_local_demo_password
DB_NAME=fleet_monitor
DB_MAX_CONNS=10

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication: leave empty to use Redis-seeded demo device keys.
VALID_API_KEYS=
AUTH_CACHE_TTL_SECONDS=300

# Background jobs
HEARTBEAT_INTERVAL_SECONDS=30
STALENESS_THRESHOLD_SECONDS=60
STOP_DETECTOR_INTERVAL_SECONDS=30
DEVIATION_DETECTOR_INTERVAL_SECONDS=60
